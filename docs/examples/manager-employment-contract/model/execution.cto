namespace com.trustblocks.municipal.employment.execution@1.0.0

import org.accordproject.runtime@0.2.0.{Request, Response} from https://models.accordproject.org/accordproject/runtime@0.2.0.cto

/**
 * Board-approval execution layer for com.trustblocks.municipal.employment --
 * added by Trustblocks, not part of the source template. model.cto is data
 * only: a completed contract's terms, with no notion of being drafted vs
 * approved. This is deliberately a separate namespace rather than an edit
 * to that one, so "their data model" and "our execution model" stay two
 * things, not one -- the same boundary com.trustblocks.template.archive
 * draws between a template's model (ingested) and its logic (never
 * auto-translated).
 */

enum ContractStatus {
  o DRAFTED
  o APPROVED
}

concept ManagerEmploymentState identified by contractId {
  o String contractId
  o ContractStatus status
  o DateTime approvedAt optional
  o DateTime effectiveDate optional
}

// Request/Response come from org.accordproject.runtime, the registry's own
// base types for what a clause is triggered with and what it answers --
// the same pair Accord's reference template extends
// (`transaction LateDeliveryAndPenaltyRequest extends Request`). Both are
// empty markers; the value is that a runtime can recognise these as a
// trigger pair rather than as two unrelated transactions.
transaction BoardApprovalRequest extends Request {
  o DateTime requestedAt
}

transaction BoardApprovalResponse extends Response {
  o ContractStatus status
  o DateTime approvedAt
  o DateTime effectiveDate
}
