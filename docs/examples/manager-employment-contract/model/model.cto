namespace us.nc.municipal.manageremployment@0.1.0

/**
 * Municipal manager employment contract.
 *
 * Derived from the China Grove / Gover contract (2025-2029, restated). The
 * source document is a council-manager form contract: ICMA ethics code,
 * without-cause severance with mitigation offsets, and a service-credit
 * purchase provision.
 *
 * Numeric terms appear twice in the prose ("four (4) years"), so each carries
 * a paired `...Written` field. Keeping the written form as data rather than
 * deriving it avoids a class of drafting error where the numeral and the words
 * disagree — which is the kind of discrepancy that gets litigated.
 *
 * Pronoun fields exist because the source contract is written in the
 * masculine throughout. They are data so the template serves any officeholder.
 */

concept ManagerEmployment {

  // ---- Jurisdiction -------------------------------------------------------
  o String stateName
  o String countyName
  o String municipalityName
  @description("Town, City, or Village")
  o String municipalityType
  @description("Town Council, Board of Aldermen, Board of Commissioners")
  o String governingBodyName

  // ---- Parties ------------------------------------------------------------
  o String employeeName
  @description("Town Manager, City Manager")
  o String positionTitle

  @description("Subject pronoun for the employee: he, she, they")
  o String pronounSubject
  @description("Object pronoun: him, her, them")
  o String pronounObject
  @description("Possessive: his, her, their")
  o String pronounPossessive

  // ---- Execution ----------------------------------------------------------
  @description("Blank in the source until signing; the day of the month")
  o String executionDay
  o String executionMonth
  o String executionYear
  @description("May precede execution where the contract is restated")
  o DateTime effectiveDate

  // ---- Authorizing action -------------------------------------------------
  @description("Meeting at which the governing body approved the contract")
  o DateTime councilActionDate
  @description("Closed-session authority, e.g. N.C.G.S. 143-318.11(a)(6)")
  o String closedSessionAuthority
  @description("e.g. \"unanimously\", \"by a vote of 4 to 1\"")
  o String councilVoteDescription
  @description("Statutory source of the manager's duties, e.g. N.C.G.S. 160A-148")
  o String dutiesAuthority
  @description("The superseded contract this agreement restates")
  o DateTime priorContractDate

  // ---- Term ---------------------------------------------------------------
  o DateTime termStartDate
  o DateTime termEndDate
  o Integer termYears
  o String termYearsWritten
  o Integer nonRenewalNoticeMonths
  o String nonRenewalNoticeMonthsWritten
  @description("Cap on outside teaching/writing/consulting without approval")
  o Integer outsideActivityHours
  o String outsideActivityHoursWritten

  // ---- Compensation -------------------------------------------------------
  @description("Formatted for prose, e.g. \"$146,500.00\"")
  o String annualBaseSalary
  @description("e.g. \"One Hundred Forty-Six Thousand Five Hundred and 00/100\"")
  o String annualBaseSalaryWritten
  @description("True where salary is retroactive and back pay is owed")
  o Boolean retroactiveSalary
  o DateTime retroactiveDate optional

  // ---- Benefits -----------------------------------------------------------
  @description("e.g. \"NC 401(k)\"")
  o String retirementPlanName
  @description("e.g. \"North Carolina Local Government Retirement System\"")
  o String retirementSystemName

  // ---- Severance ----------------------------------------------------------
  @description("Years of salary/benefit continuation on without-cause termination")
  o Integer severanceYears
  o String severanceYearsWritten
  @description("Service years required to trigger the credit-purchase option")
  o Integer retirementServiceYears
  o String retirementServiceYearsWritten
  @description("Months-remaining window in which the employer may purchase credits")
  o Integer serviceCreditWindowMonths
  o String serviceCreditWindowMonthsWritten

  // ---- Professional -------------------------------------------------------
  @description("e.g. \"International City/County Management Association (ICMA)\"")
  o String ethicsCodeOrganization
  @description("e.g. \"North Carolina League of Municipalities\"")
  o String stateMunicipalLeagueName

  // ---- Allowances ---------------------------------------------------------
  o Boolean automobileStipendProvided
  @description("Monthly stipend, formatted, e.g. \"$350.00\"")
  o String automobileStipend optional
  @description("Officer authorized to disburse expense reimbursements")
  o String financeOfficerTitle

  // ---- Signatories --------------------------------------------------------
  o String presidingOfficerName
  o String presidingOfficerTitle
  o String clerkName
  o String clerkTitle
}
