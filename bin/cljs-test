#!/usr/bin/env bash
# The clause runtime's parity test, compiled to ClojureScript and run under
# Node: the same test/com/trustblocks/clause_parity_test.cljc the JVM suite
# runs, held to the same answers recorded from the JVM.
set -euo pipefail
cd "$(dirname "$0")/.."
exec bin/clj -M:cljs compile clause-test
