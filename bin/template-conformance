#!/usr/bin/env bash
# Check every template under docs/examples against Accord Project's own
# toolchain -- cicero-core must load the archive, template-engine must draft
# it. See dev/conformance.cljs and docs/templatemark-conformance.md.
#
# Node-only, and dev-only: the reference implementation is JavaScript and has
# no JVM port, so this is the one place the project needs Node. It is not on
# any request path and not part of `bin/clj -M:run code-quality`, so a
# Clojure-only change needs none of it.
#
# Usage:  bin/template-conformance [dir]     (default: docs/examples)
set -euo pipefail

cd "$(dirname "$0")/.."

if ! command -v node >/dev/null 2>&1; then
  echo "error: node is not on PATH" >&2
  echo "this check runs Accord's own JavaScript toolchain; install Node 20+" >&2
  exit 1
fi

if [[ ! -x node_modules/.bin/nbb ]]; then
  echo "error: tooling not installed" >&2
  echo "run: npm install     (dev-only; node_modules is gitignored)" >&2
  exit 1
fi

exec node_modules/.bin/nbb dev/conformance.cljs "$@"
