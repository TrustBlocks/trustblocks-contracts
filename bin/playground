#!/usr/bin/env bash
# Run Trustblocks' Template Playground locally -- TrustBlocks' fork of
# Accord Project's playground (github.com/TrustBlocks/template-playground,
# branch `trustblocks`), which runs a template's Clojure logic with
# Trustblocks' own clause runtime. See docs/template-playground-webmcp.md.
#
# The same playground is hosted at https://trustblocks.github.io/template-playground/,
# and the app links there by default. Run it locally to try a template change
# before it is published, or for the WebMCP agent relay, which exists only in
# the Vite development build.
#
# Keeps a sibling checkout (never inside this repo) at a pinned commit of the
# fork, installs its dependencies when they are missing or stale, brings in the
# logic runtime and samples from the sibling trustblocks-templates checkout
# the first time (bb logic-bundle there, then the fork's
# scripts/sync-trustblocks.mjs), and serves it on http://localhost:5173.
# Point Trustblocks at it with
#   TRUSTBLOCKS_TEMPLATE_PLAYGROUND_ORIGIN=http://localhost:5173
#
# Usage:  bin/playground
#   TRUSTBLOCKS_PLAYGROUND_DIR  checkout location (default ~/Code/trustblocks-playground)
#   TRUSTBLOCKS_PLAYGROUND_REF  commit to run (default: the one last verified)
#   TRUSTBLOCKS_TEMPLATES_DIR   trustblocks-templates checkout (default ~/Code/trustblocks-templates)
set -euo pipefail

repo=https://github.com/TrustBlocks/template-playground.git
dir="${TRUSTBLOCKS_PLAYGROUND_DIR:-$HOME/Code/trustblocks-playground}"
templates="${TRUSTBLOCKS_TEMPLATES_DIR:-$HOME/Code/trustblocks-templates}"
# The fork's `trustblocks` branch as verified: the Clojure runtime merged
# (TrustBlocks/template-playground#1). Moving it is a deliberate act.
ref="${TRUSTBLOCKS_PLAYGROUND_REF:-9ec1f9bde69cfee2c038e2d7c43eddd8753cb48b}"
port=5173

if ! command -v node >/dev/null 2>&1; then
  echo "error: node is not on PATH (the playground is a Node/Vite app)" >&2
  exit 1
fi

if [[ ! -d "$dir/.git" ]]; then
  echo "Cloning $repo into $dir ..."
  git clone --quiet --branch trustblocks "$repo" "$dir"
fi

cd "$dir"

if [[ "$(git rev-parse HEAD)" != "$ref" ]]; then
  if [[ -n "$(git status --porcelain)" ]]; then
    echo "error: $dir has local changes and is not at $ref; refusing to switch" >&2
    exit 1
  fi
  git cat-file -e "$ref^{commit}" 2>/dev/null || git fetch --quiet origin trustblocks
  git checkout --quiet --detach "$ref"
fi

# npm records the lockfile it last installed from; reinstall when it is
# missing or older than the checkout's own lockfile.
if [[ ! -f node_modules/.package-lock.json || package-lock.json -nt node_modules/.package-lock.json ]]; then
  echo "Installing playground dependencies (npm ci) ..."
  npm ci --no-audit --no-fund
fi

# The logic runtime is built, not committed: from trustblocks-templates at the
# commit the fork's trustblocks.json pins.
if [[ ! -f public/trustblocks-logic.js ]]; then
  if [[ ! -d "$templates/.git" ]]; then
    echo "error: no trustblocks-templates checkout at $templates (set TRUSTBLOCKS_TEMPLATES_DIR)" >&2
    exit 1
  fi
  if [[ ! -f "$templates/target/trustblocks-logic.js" ]]; then
    echo "Building the logic runtime (bb logic-bundle in $templates) ..."
    (cd "$templates" && bb logic-bundle)
  fi
  node scripts/sync-trustblocks.mjs "$templates"
fi

if lsof -nP -iTCP:"$port" -sTCP:LISTEN -t >/dev/null 2>&1; then
  echo "error: port $port is already in use -- is the playground already running?" >&2
  exit 1
fi

echo "Trustblocks Template Playground (trustblocks @ ${ref:0:7}) on http://localhost:$port"
exec npm run dev -- --port "$port" --strictPort
