{:paths ["src" "resources" "target/resources"]

 ;; decentralized-identity/did-common-java (below) lives on Danube Tech's own
 ;; repo, not Central -- see com.trustblocks.did.vc's namespace docstring
 ;; for why we accepted that one extra repo but not com.danubetech/
 ;; verifiable-credentials-java's, which needs this one *and* JitPack *and*
 ;; a Bitcoin/Ethereum crypto stack we never call.
 :mvn/repos {"danubetech-maven-public"
             {:url "https://repo.danubetech.com/repository/maven-public/"}}

 :deps {org.clojure/clojure {:mvn/version "1.12.5"}

        ;; Biff 2 libraries, pinned to the official 2.0.0 release (2026-09-10).
        ;; Upgrade deliberately, never track branch HEAD.
        com.biffweb/core     {:mvn/version "2.0.0"}
        com.biffweb/config   {:mvn/version "2.0.0"}
        com.biffweb/ring     {:mvn/version "2.0.0"}
        com.biffweb/xtdb     {:mvn/version "2.0.0"}
        com.biffweb/datastar {:mvn/version "2.0.0"}
        com.biffweb/graph    {:mvn/version "2.0.0"}
        ;; Passwordless email signin. Needs :biff.core/kv-get and
        ;; :biff.core/kv-set at runtime, which com.biffweb/xtdb already
        ;; provides -- see com.trustblocks.app.auth.
        com.biffweb/authenticate {:mvn/version "2.0.0"}

        ;; LZ-String compression, for links out to Accord Project's own
        ;; playgrounds -- see com.trustblocks.model.playground. Their share
        ;; links encode a model/template as JSON, then LZ-String-compress it
        ;; into the URL; this is the one JVM port confirmed byte-compatible
        ;; with lz-string 1.5.0 (what both playgrounds ship), checked both
        ;; ways -- Java-compressed decompresses correctly in Node's lz-string,
        ;; and vice versa.
        com.github.tommyettinger/blazingchain {:mvn/version "1.4.4.6"}

        ;; DID documents (did:web, did:key) and W3C Verifiable Credentials --
        ;; see com.trustblocks.did.interop and com.trustblocks.did.vc.
        ;; did-common-java is the DID document object model; the VC side is
        ;; hand-rolled on nimbus-jose-jwt rather than com.danubetech/
        ;; verifiable-credentials-java (see deps.edn's :mvn/repos comment
        ;; above and com.trustblocks.did.vc's docstring for why).
        ;; Tink is not optional scaffolding: nimbus-jose-jwt's Ed25519Signer/
        ;; Ed25519Verifier are Tink-backed in every version checked, with or
        ;; without BouncyCastle installed as a provider. bcprov is pinned
        ;; explicitly rather than left to whatever buddy-core resolves it to
        ;; transitively.
        decentralized-identity/did-common-java {:mvn/version "1.17.0"}
        com.nimbusds/nimbus-jose-jwt           {:mvn/version "10.0.2"}
        com.google.crypto.tink/tink            {:mvn/version "1.17.0"}
        org.bouncycastle/bcprov-jdk18on        {:mvn/version "1.80"}

        ;; Concerto models as EDN and Malli schemas compiled from them at
        ;; runtime. Not on Clojars yet -- see github.com/TrustBlocks/concerto-clj.
        io.github.TrustBlocks/concerto-clj {:git/sha "d80655fb6b737765e60e66e0a8277e8b12daa4db"}

        ;; The municipal contract templates this app runs -- models, text,
        ;; and Clojure clause logic -- each on the classpath under its own
        ;; name. See com.trustblocks.template.library, and the :templates-local
        ;; alias below for editing them alongside the app.
        io.github.TrustBlocks/trustblocks-templates {:git/sha "b0377d9efdcb6e95132c08787acb4b6ab4da3b04"}

        dev.onionpancakes/chassis     {:mvn/version "1.0.365"}
        ;; CommonMark + pipe tables -- exactly the markdown TemplateMark is
        ;; defined over -- for rendering a contract's text on Contract View.
        ;; See com.trustblocks.template.render.
        org.commonmark/commonmark                {:mvn/version "0.24.0"}
        org.commonmark/commonmark-ext-gfm-tables {:mvn/version "0.24.0"}
        metosin/malli                 {:mvn/version "0.20.1"}
        cheshire/cheshire             {:mvn/version "6.2.0"}
        camel-snake-kebab/camel-snake-kebab {:mvn/version "0.4.3"}
        babashka/process              {:mvn/version "0.6.25"}
        ;; Contract clause logic runs in an interpreter with an explicitly
        ;; configured vocabulary -- see com.trustblocks.clause.
        org.babashka/sci              {:mvn/version "0.10.47"}
        org.clojure/tools.logging     {:mvn/version "1.3.1"}
        org.clojure/tools.namespace   {:mvn/version "1.5.1"}
        org.slf4j/slf4j-simple        {:mvn/version "2.0.18"}
        nrepl/nrepl                   {:mvn/version "1.7.0"}
        cider/cider-nrepl             {:mvn/version "0.59.0"}}

 :aliases
 {;; XTDB 2.1.0 needs these to reach Arrow's off-heap buffers through
  ;; java.nio. Required on any JVM that starts the node. Also note XTDB 2.1.0
  ;; runs on Java 21-24 only -- Java 25 will not work.
  :xtdb-jvm-opts
  {:extra-paths ["dev"]
   ;; Lets dev/seed.clj build CSS once (com.biffweb.tasks/css) without going
   ;; through the :run alias's :main-opts, which would hijack -i file loading.
   :extra-deps  {com.biffweb/tasks {:mvn/version "2.0.0"}}
   :jvm-opts    ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                 "--enable-native-access=ALL-UNNAMED"
                 "-Dio.netty.tryReflectionSetAccessible=true"]}

  :run
  {:extra-paths ["test" "dev"]
   :extra-deps  {com.biffweb/tasks {:mvn/version "2.0.0"}}
   :main-opts   ["-m" "com.biffweb.tasks.app"]
   :jvm-opts    ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                 "--enable-native-access=ALL-UNNAMED"
                 "-Dio.netty.tryReflectionSetAccessible=true"]}

  :prod
  {:main-opts ["-m" "com.trustblocks"]
   :jvm-opts  ["--add-opens=java.base/java.nio=ALL-UNNAMED"
               "--enable-native-access=ALL-UNNAMED"
               "-Dio.netty.tryReflectionSetAccessible=true"
               "-Djdk.attach.allowAttachSelf"
               "-XX:-OmitStackTraceInFastThrow"
               "-XX:+CrashOnOutOfMemoryError"]}

  ;; Run against the sibling ../trustblocks-templates checkout instead of
  ;; the pinned commit, to try a template change in the app before it is
  ;; committed there. Usage: bin/clj -M:templates-local:run test
  :templates-local
  {:override-deps
   {io.github.TrustBlocks/trustblocks-templates {:local/root "../trustblocks-templates"}}}

  ;; Develop against the sibling biff/ clone instead of the pinned releases,
  ;; e.g. when preparing an upstream PR or using an unreleased lib. Now that
  ;; 2.0.0 is released and every Biff 2 lib is published on Clojars, this is
  ;; only needed to track master past the 2.0.0 tag.
  ;; Usage: clj -M:biff-local:run dev
  ;; :override-deps (not :extra-deps) so Biff's own inter-lib deps resolve
  ;; locally too.
  :biff-local
  {:override-deps
   {com.biffweb/core     {:local/root "biff/libs/core"}
    com.biffweb/config   {:local/root "biff/libs/config"}
    com.biffweb/ring     {:local/root "biff/libs/ring"}
    com.biffweb/xtdb     {:local/root "biff/libs/xtdb"}
    com.biffweb/datastar {:local/root "biff/libs/datastar"}
    com.biffweb/fx       {:local/root "biff/libs/fx"}
    com.biffweb/graph    {:local/root "biff/libs/graph"}
    com.biffweb/stuff    {:local/root "biff/libs/stuff"}}}}}
