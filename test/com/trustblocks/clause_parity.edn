{\"$class\" \"com.trustblocks.attestation@1.0.0.AttestationResponse\"\n                \"$timestamp\" now\n                \"statement\" (get request \"statement\")\n                \"documentHash\" (get request \"documentHash\")}}\n\n    ;; Anything else is not a request this contract answers.\n    :else\n    (throw (ex-info (str \"This contract does not answer \" event) {}))))\n", :data {"annualBaseSalary" "$146,500.00", "clerkTitle" "Town Clerk", "retirementServiceYearsWritten" "thirty", "stateCode" "NC", "pronounObject" "him", "councilActionDate" "2025-12-02T00:00:00.000Z", "retirementSystemName" "North Carolina Local Government Retirement System", "retirementServiceYears" 30, "retroactiveDate" "2025-07-01T00:00:00.000Z", "nonRenewalNoticeMonths" 6, "outsideActivityHoursWritten" "twenty", "termYearsWritten" "four", "ethicsCodeOrganization" "International City/County Management Association (ICMA)", "annualBaseSalaryWritten" "One Hundred Forty-Six Thousand Five Hundred and 00/100", "closedSessionAuthority" "N.C. Gen. Stat. § 143-318.11(a)(6)", "effectiveDate" "2025-07-01T00:00:00.000Z", "$class" "com.trustblocks.municipal.employment@1.0.0.ManagerEmployment", "municipalityType" "TOWN", "financeOfficerTitle" "Finance Director", "termStartDate" "2025-07-01T00:00:00.000Z", "nonRenewalNoticeMonthsWritten" "six", "employeeName" "FRANKLIN GOVER", "outsideActivityHours" 20, "executionYear" "2026", "countyName" "ROWAN", "municipalityName" "CHINA GROVE", "governingBodyName" "Town Council", "serviceCreditWindowMonthsWritten" "twelve", "severanceYears" 2, "stateMunicipalLeagueName" "North Carolina League of Municipalities", "priorContractDate" "2024-06-06T00:00:00.000Z", "contractId" "china-grove-gover-2025", "positionTitle" "Town Manager", "stateName" "NORTH CAROLINA", "pronounSubject" "he", "termYears" 4, "automobileStipend" "$350.00", "councilVoteDescription" "unanimously", "severanceYearsWritten" "two", "presidingOfficerTitle" "Mayor", "dutiesAuthority" "North Carolina Ge